# Tardis 설치 스크립트 테스트용 깡통 우분투 이미지
FROM ubuntu:24.04

# 필수 유틸리티 (curl, wget, sudo, ca-certificates) 설치
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    sudo \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# install.sh 내부의 sudo 명령어가 비밀번호를 묻지 않도록 처리
RUN echo "ALL ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

WORKDIR /root
CMD ["/bin/bash"]
